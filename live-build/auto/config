#!/bin/sh
# Ultron OS — live-build configuration.
# Run through scripts/build-iso.sh (or ./build.sh), not directly.
set -e

: "${ULTRON_VERSION:=1.0}"
: "${ULTRON_COMPRESSION:=xz}"          # xz = smallest ISO, zstd = much faster build
: "${ULTRON_MIRROR:=http://deb.debian.org/debian}"
: "${ULTRON_SECURITY_MIRROR:=http://security.debian.org/debian-security}"

VOLUME="ULTRON_$(echo "${ULTRON_VERSION}" | tr -c 'A-Za-z0-9\n' '_')"

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --mirror-bootstrap "${ULTRON_MIRROR}" \
    --mirror-chroot "${ULTRON_MIRROR}" \
    --mirror-chroot-security "${ULTRON_SECURITY_MIRROR}" \
    --mirror-binary "http://deb.debian.org/debian" \
    --mirror-binary-security "http://security.debian.org/debian-security" \
    --security true \
    --updates true \
    --backports false \
    --apt-recommends true \
    --apt-indices false \
    --binary-image iso-hybrid \
    --bootloaders "grub-pc,grub-efi" \
    --uefi-secure-boot auto \
    --debian-installer none \
    --memtest none \
    --firmware-chroot false \
    --firmware-binary false \
    --linux-flavours amd64 \
    --initramfs live-boot \
    --initsystem systemd \
    --chroot-squashfs-compression-type "${ULTRON_COMPRESSION}" \
    --bootappend-live "boot=live components quiet splash username=ultron hostname=ultron-live locales=en_US.UTF-8" \
    --iso-application "Ultron OS" \
    --iso-publisher "Ultron OS Project" \
    --iso-preparer "live-build" \
    --iso-volume "${VOLUME}" \
    --image-name "ultronos-${ULTRON_VERSION}" \
    --checksums sha256 \
    --zsync false \
    --cache true \
    --cache-packages true \
    "${@}"
