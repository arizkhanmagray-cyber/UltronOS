#!/bin/sh
# Windows program support: Wine for 64-bit and 32-bit programs.
# Most .exe installers and nearly all .msi custom actions are still 32-bit,
# so the i386 half is not optional if double-clicking a download is to work.
set -e
export DEBIAN_FRONTEND=noninteractive

dpkg --add-architecture i386
apt-get update
apt-get install -y --no-install-recommends \
    wine wine64 wine32:i386 \
    libgl1:i386 libgl1-mesa-dri:i386 \
    winetricks cabextract fonts-liberation

# Sanity check: both halves must be present or the feature silently half-works.
[ -e /usr/lib/x86_64-linux-gnu/wine/x86_64-windows/msiexec.exe ] || { echo "64-bit Wine missing"; exit 1; }
[ -e /usr/lib/i386-linux-gnu/wine/i386-windows/msiexec.exe ] || { echo "32-bit Wine missing"; exit 1; }

update-desktop-database -q /usr/share/applications 2>/dev/null || true
update-mime-database /usr/share/mime 2>/dev/null || true
